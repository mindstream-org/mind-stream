# Script Model Provider configuration
# Options: "groq" (Llama 3.3 70B) or "gemini" (Gemini 2.0 Flash)
SCRIPT_MODEL_PROVIDER=groq
SCRIPT_MODEL_NAME=llama-3.3-70b-versatile

# API Keys
# Required for script generation when SCRIPT_MODEL_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here

# Required for script generation when SCRIPT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here

# Required for stock background footage
PEXELS_API_KEY=your_pexels_key_here

# Required for text-to-speech narration
MIMO_API_KEY=your_mimo_key_here

# Optional fallback video source
PIXABAY_API_KEY=
