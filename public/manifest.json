{
  "manifest_version": 3,
  "name": "Mind Stream",
  "version": "0.1.0",
  "description": "An extension for Mind Stream — Detects distraction, resets focus.",
  "minimum_chrome_version": "141",
  "action": {
    "default_title": "Mind Stream",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
